{
  "name": "@nivalis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sync-runtime": "./src/sync-runtime.ts"
  },
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "db:migrate": "tsx src/cli/database.ts migrate",
    "db:migrate:status": "tsx src/cli/database.ts status",
    "db:rollback": "tsx src/cli/database.ts rollback",
    "db:seed": "tsx src/cli/database.ts seed",
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "test:smoke": "node scripts/smoke-built-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@nivalis/application": "workspace:*",
    "@nivalis/domain": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pg-boss": "12.27.0",
    "pino": "10.3.1",
    "typebox": "1.3.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
